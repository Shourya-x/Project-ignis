{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (CMake Debug)",
            "type": "shell",
            "command": "cube-cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/IGNIS_CORE_STM32G473VET6"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build & Flash STM32 (ST-Link)",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/IGNIS_CORE_STM32G473VET6/build/Debug/IGNIS_CORE_STM32G473VET6.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": [
                "Build (CMake Debug)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
