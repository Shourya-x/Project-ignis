---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Hardware & Engineering Downloads Vault | Project IGNIS">
  <Header />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-index">VAULT // DIRECT ENGINEERING ARCHIVES</span>
          <h1 class="section-title">Hardware, ECAD &amp; 3D CAD Downloads</h1>
        </div>
        <p class="section-desc">
          Verified, direct download links to KiCad schematics, mechanical 3D STEP/GLB models, STL airframe components, and firmware archives.
        </p>
      </div>

      <div class="vault-grid">
        <!-- ECAD Schematics -->
        <div class="panel dl-category">
          <span class="badge badge-accent">ECAD SCHEMATICS (PDF)</span>
          <h2>Electrical Schematics</h2>
          <ul class="dl-list mono">
            <li>
              <a href="/docs/ignis-core-schematics.pdf" download class="dl-item">
                <span>IGNIS-CORE Flight Computer Schematic (PDF)</span>
                <span class="badge">243 KB</span>
              </a>
            </li>
            <li>
              <a href="/docs/datalogger-schematics.pdf" download class="dl-item">
                <span>Aux Blackbox Data Logger Schematic (PDF)</span>
                <span class="badge">164 KB</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- 3D PCBA Models -->
        <div class="panel dl-category">
          <span class="badge badge-blue">3D PCBA CAD (STEP / GLB)</span>
          <h2>Electronic Assemblies</h2>
          <ul class="dl-list mono">
            <li>
              <a href="/models/ignis-core-pcb.step" download class="dl-item">
                <span>IGNIS-CORE Populated PCBA (STEP)</span>
                <span class="badge">11.0 MB</span>
              </a>
            </li>
            <li>
              <a href="/models/ignis-core-pcb.glb" download class="dl-item">
                <span>IGNIS-CORE WebGL Model (GLB)</span>
                <span class="badge">4.8 MB</span>
              </a>
            </li>
            <li>
              <a href="/models/datalogger-pcb.glb" download class="dl-item">
                <span>Aux Blackbox Data Logger (GLB)</span>
                <span class="badge">884 KB</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- 3D Printable Airframe -->
        <div class="panel dl-category">
          <span class="badge badge-green">3D PRINTING (STL)</span>
          <h2>Airframe &amp; Structural Sleds</h2>
          <ul class="dl-list mono">
            <li>
              <a href="/models/AvionicsBay.stl" download class="dl-item">
                <span>Modular Avionics Bay Structural Sled (STL)</span>
                <span class="badge">124 KB</span>
              </a>
            </li>
            <li>
              <a href="/models/nose_cone.stl" download class="dl-item">
                <span>Aerodynamic Nose Cone (STL)</span>
                <span class="badge">578 KB</span>
              </a>
            </li>
            <li>
              <a href="/models/fin.stl" download class="dl-item">
                <span>High-Speed Trapezoidal Control Fin (STL)</span>
                <span class="badge">42 KB</span>
              </a>
            </li>
            <li>
              <a href="/models/rocket_body.stl" download class="dl-item">
                <span>Rocket Body Airframe Section (STL)</span>
                <span class="badge">50 KB</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Full Airframe CAD -->
        <div class="panel dl-category">
          <span class="badge badge-amber">FULL ASSEMBLY CAD</span>
          <h2>Airframe CAD Assemblies</h2>
          <ul class="dl-list mono">
            <li>
              <a href="/models/rocket-full.step" download class="dl-item">
                <span>Complete Rocket Airframe Assembly (STEP)</span>
                <span class="badge">15 KB</span>
              </a>
            </li>
            <li>
              <a href="/models/Rocket.gltf" download class="dl-item">
                <span>Full Rocket Assembly (glTF)</span>
                <span class="badge">14 KB</span>
              </a>
            </li>
            <li>
              <a href="/models/AvionicsBay.gltf" download class="dl-item">
                <span>Avionics Bay Assembly (glTF)</span>
                <span class="badge">10 KB</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- License & Source Note -->
      <div class="panel" style="margin-top:2.5rem;">
        <span class="badge badge-accent">OPEN HARDWARE &amp; REPOSITORIES</span>
        <h3 style="margin:0.5rem 0;">Source Repositories &amp; Licensing Information</h3>
        <p class="body-copy">
          All hardware schematics, PCB layouts, and mechanical CAD designs are released under the <strong>CERN Open Hardware Licence v2 — Permissive (CERN-OHL-P v2)</strong>. All STM32 HAL C firmware, Python ground station applications, and telemetry libraries are licensed under the <strong>MIT License</strong>.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .dl-category h2 {
    font-size: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .dl-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .dl-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }
  .dl-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
