  // ==========================================
  // 4. LIVE FLIGHT TELEMETRY REPLAYER (CANVAS)
  // ==========================================
  (function () {
    const data = SAMPLE_FLIGHT_DATA || [];
    const canvas = document.getElementById('flight-canvas');
    if (!canvas || !data.length) return;
    const ctx = canvas.getContext('2d');
    const scrubber = document.getElementById('replay-scrubber');
    const playBtn = document.getElementById('replay-play-btn');
    const resetBtn = document.getElementById('replay-reset-btn');
    const speedBtns = document.querySelectorAll('.speed-btn');

    let isPlaying = false;
    let playTimer = null;
    let speedMult = 1;
    let currentIndex = 0;

    function drawGraph(activeIdx) {
      if (!ctx) return;
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      // Background grid lines
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.15)';
      ctx.lineWidth = 1;
      for (let y = 30; y < H; y += 45) {
        ctx.beginPath();
        ctx.moveTo(40, y);
        ctx.lineTo(W - 20, y);
        ctx.stroke();
      }

      const maxAlt = 1400;
      const maxSpeed = 350;
      const count = data.length;
      const stepX = (W - 80) / (count - 1);

      // Draw Altitude curve (Orange)
      ctx.beginPath();
      ctx.strokeStyle = '#f97316';
      ctx.lineWidth = 2.5;
      data.forEach((pt, i) => {
        const x = 50 + i * stepX;
        const y = H - 25 - (pt.alt / maxAlt) * (H - 55);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();

      // Draw Speed curve (Blue)
      ctx.beginPath();
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 2;
      data.forEach((pt, i) => {
        const x = 50 + i * stepX;
        const y = H - 25 - (pt.speed / maxSpeed) * (H - 55);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();

      // Vertical cursor at active timestamp
      const curX = 50 + activeIdx * stepX;
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(curX, 10);
      ctx.lineTo(curX, H - 20);
      ctx.stroke();
      ctx.setLineDash([]);

      // Cursor point circle
      const curPt = data[activeIdx];
      const curAltY = H - 25 - (curPt.alt / maxAlt) * (H - 55);
      ctx.fillStyle = '#f97316';
      ctx.beginPath();
      ctx.arc(curX, curAltY, 5, 0, Math.PI * 2);
      ctx.fill();
    }

    function updateReplayer(idx) {
      currentIndex = clamp(idx, 0, data.length - 1);
      const pt = data[currentIndex];
      if (!pt) return;

      document.getElementById('hud-alt').textContent = `${pt.alt.toFixed(1)} m`;
      document.getElementById('hud-speed').textContent = `${pt.speed.toFixed(1)} km/h`;
      document.getElementById('hud-att').textContent = `θ: ${pt.pitch.toFixed(1)}° • ϕ: ${pt.roll.toFixed(1)}°`;
      document.getElementById('hud-pres').textContent = `${pt.pres.toFixed(1)} hPa`;
      document.getElementById('replay-time-label').textContent = `T+ ${pt.t} ms`;

      if (scrubber) scrubber.value = `${pt.t}`;
      drawGraph(currentIndex);
    }

    function clamp(v, lo, hi) {
      return Math.max(lo, Math.min(hi, v));
    }

    if (scrubber) {
      scrubber.addEventListener('input', () => {
        const tVal = parseInt(scrubber.value, 10);
        const idx = data.findIndex((d) => d.t >= tVal);
        updateReplayer(idx !== -1 ? idx : 0);
      });
    }

    if (playBtn) {
      playBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playBtn.textContent = '⏸ PAUSE';
          playBtn.classList.remove('btn-primary');
          playTimer = setInterval(() => {
            if (currentIndex >= data.length - 1) {
              currentIndex = 0;
            } else {
              currentIndex++;
            }
            updateReplayer(currentIndex);
          }, 100 / speedMult);
        } else {
          playBtn.textContent = '▶ PLAY FLIGHT';
          playBtn.classList.add('btn-primary');
          if (playTimer) clearInterval(playTimer);
        }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (playTimer) clearInterval(playTimer);
        isPlaying = false;
        if (playBtn) { playBtn.textContent = '▶ PLAY FLIGHT'; playBtn.classList.add('btn-primary'); }
        updateReplayer(0);
      });
    }

    speedBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        speedBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        speedMult = parseFloat(btn.getAttribute('data-speed') || '1');
        if (isPlaying) {
          clearInterval(playTimer);
          playTimer = setInterval(() => {
            if (currentIndex >= data.length - 1) currentIndex = 0;
            else currentIndex++;
            updateReplayer(currentIndex);
          }, 100 / speedMult);
        }
      });
    });

    updateReplayer(0);
  })();

  // ==========================================
  // 5. INTERACTIVE FIN SIZING & TORQUE CALCULATOR
  // ==========================================
  (function () {
    const inVel = document.getElementById('calc-vel');
    const inArea = document.getElementById('calc-area');
    const inOffset = document.getElementById('calc-offset');
    const inDef = document.getElementById('calc-def');

    function updateCalc() {
      const v = parseFloat(inVel ? inVel.value : '150');
      const areaCm2 = parseFloat(inArea ? inArea.value : '35');
      const offsetMm = parseFloat(inOffset ? inOffset.value : '8');
      const defDeg = parseFloat(inDef ? inDef.value : '15');

      document.getElementById('calc-val-vel').textContent = `${v} m/s (${Math.round(v * 3.6)} km/h)`;
      document.getElementById('calc-val-area').textContent = `${areaCm2} cm²`;
      document.getElementById('calc-val-offset').textContent = `${offsetMm.toFixed(1)} mm`;
      document.getElementById('calc-val-def').textContent = `${defDeg}°`;

      const rho = 1.225; // sea-level air density
      const q = 0.5 * rho * v * v; // Pa
      const areaM2 = areaCm2 / 10000;
      const defRad = (defDeg * Math.PI) / 180;
      const CN_alpha = 3.2; // normal force slope per radian
      const normalForceN = q * areaM2 * CN_alpha * defRad;
      const torqueNm = normalForceN * (offsetMm / 1000);
      const torqueKgCm = torqueNm * 10.197; // 1 N·m = 10.197 kg·cm
      const torqueSafe = torqueKgCm * 2.0;

      document.getElementById('res-q').textContent = `${(q / 1000).toFixed(2)} kPa`;
      document.getElementById('res-force').textContent = `${normalForceN.toFixed(2)} N (${(normalForceN / 9.81).toFixed(2)} kgf)`;
      document.getElementById('res-torque').textContent = `${torqueKgCm.toFixed(2)} kg·cm`;

      const verdictEl = document.getElementById('res-verdict');
      if (verdictEl) {
        if (torqueSafe < 2.5) {
          verdictEl.textContent = `Standard Metal-Gear Micro Servos (e.g. EMAX ES08MDII or Corona DS-939MG, 2.0–2.5 kg·cm) provide ample torque margin.`;
        } else if (torqueSafe < 5.0) {
          verdictEl.textContent = `High-Torque Thin Wing Servos (e.g. KST DS135MG or Corona CS239MG, 4.0+ kg·cm) recommended to prevent aerodynamic blowback.`;
        } else {
          verdictEl.textContent = `Heavy-Duty High-Speed Coreless Servos (6.0+ kg·cm) required due to extreme transonic dynamic pressure.`;
        }
      }
    }

    if (inVel) inVel.addEventListener('input', updateCalc);
    if (inArea) inArea.addEventListener('input', updateCalc);
    if (inOffset) inOffset.addEventListener('input', updateCalc);
    if (inDef) inDef.addEventListener('input', updateCalc);

    updateCalc();
  })();

  // ==========================================
  // 6. BENCHTOP SERIAL TERMINAL SIMULATOR
  // ==========================================
  (function () {
    const screen = document.getElementById('term-screen');
    const input = document.getElementById('term-input');
    const sendBtn = document.getElementById('term-send-btn');
    const clearBtn = document.getElementById('term-clear-btn');
    const quickBtns = document.querySelectorAll('.term-btn');

    function appendLine(text, color) {
      if (!screen) return;
      const line = document.createElement('div');
      line.className = 'term-line';
      if (color) line.style.color = color;
      line.textContent = text;
      screen.appendChild(line);
      screen.scrollTop = screen.scrollHeight;
    }

    function executeCmd(raw) {
      const cmd = (raw || '').trim().toUpperCase();
      if (!cmd) return;
      appendLine(`> ${cmd}`, '#ffffff');

      if (cmd === 'A') {
        appendLine('>>> ARMED <<<', 'var(--red)');
        appendLine('Flight loop active: 100 Hz PID & Fin Mixing enabled. LED set to RED.');
      } else if (cmd === 'D') {
        appendLine('>>> DISARMED <<<', 'var(--green)');
        appendLine('Flight loop idle: Fin servos locked to neutral 90°. LED set to GREEN.');
      } else if (cmd === 'C') {
        appendLine('Calibrating... KEEP BOARD STILL!', 'var(--amber)');
        setTimeout(() => {
          appendLine('Offsets: A(-12,24,-18) G(4,-2,1)', 'var(--text-secondary)');
          appendLine('Calibration complete. LED restored.', 'var(--green)');
        }, 600);
      } else if (cmd === 'S') {
        appendLine('=== SENSOR DIAGNOSTIC ===', 'var(--accent)');
        appendLine('Scanning I2C2 bus (SCL=PC4, SDA=PA8)...');
        appendLine('  [FOUND] 0x1E -> HMC5883L Magnetometer');
        appendLine('  [FOUND] 0x50 -> 24LC16B EEPROM');
        appendLine('  [FOUND] 0x68 -> MPU6500 IMU (WHO_AM_I: 0x70 OK)');
        appendLine('  [FOUND] 0x77 -> MS5611 Barometer (T=25.4C, P=101325 Pa)');
      } else {
        appendLine(`Unknown command: "${cmd}". Available: A, D, C, S`, 'var(--amber)');
      }
    }

    quickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        executeCmd(btn.getAttribute('data-cmd') || '');
      });
    });

    if (sendBtn && input) {
      sendBtn.addEventListener('click', () => {
        executeCmd(input.value);
        input.value = '';
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          executeCmd(input.value);
          input.value = '';
        }
      });
    }

    if (clearBtn && screen) {
      clearBtn.addEventListener('click', () => {
        screen.innerHTML = '';
        appendLine('=== TERMINAL CLEARED ===', 'var(--text-muted)');
      });
    }
  })();

  // ==========================================
  // 7. ECAD SCHEMATIC & PCB EXPLORER
  // ==========================================
  (function () {
    const img = document.getElementById('ecad-image');
    const cap = document.getElementById('ecad-caption');
    const zoomLbl = document.getElementById('ecad-zoom-label');
    const tabs = document.querySelectorAll('.ecad-tab');
    let scale = 1;

    function applyScale() {
      if (img) img.style.transform = `scale(${scale})`;
      if (zoomLbl) zoomLbl.textContent = `SCALE: ${Math.round(scale * 100)}%`;
    }

    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        tabs.forEach((b) => b.classList.remove('active'));
        t.classList.add('active');
        const src = t.getAttribute('data-img');
        const c = t.getAttribute('data-caption');
        if (img && src) img.setAttribute('src', src);
        if (cap && c) cap.textContent = c;
        scale = 1;
        applyScale();
      });
    });

    const zIn = document.getElementById('ecad-zoom-in');
    const zOut = document.getElementById('ecad-zoom-out');
    const zReset = document.getElementById('ecad-zoom-reset');
    if (zIn) zIn.addEventListener('click', () => { scale = Math.min(4, scale + 0.25); applyScale(); });
    if (zOut) zOut.addEventListener('click', () => { scale = Math.max(0.5, scale - 0.25); applyScale(); });
    if (zReset) zReset.addEventListener('click', () => { scale = 1; applyScale(); });
  })();

  // ==========================================
  // 8. PINOUT & BOM SEARCH & CSV EXPORTER
  // ==========================================
  (function () {
    const searchInput = document.getElementById('bom-search');
    const rows = document.querySelectorAll('.filterable-row');
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase().trim();
        rows.forEach((r) => {
          const txt = r.textContent ? r.textContent.toLowerCase() : '';
          r.style.display = !q || txt.includes(q) ? '' : 'none';
        });
      });
    }

    const csvBtn = document.getElementById('export-bom-csv');
    if (csvBtn) {
      csvBtn.addEventListener('click', () => {
        const lines = ['Board,Reference,Qty,Value,Package,Category,Description'];
        document.querySelectorAll('#bom-table tbody tr').forEach((tr) => {
          const rowCsv = tr.getAttribute('data-csv');
          if (rowCsv) lines.push(rowCsv);
        });
        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Project-IGNIS-Dual-Board-BOM.csv';
        a.click();
        URL.revokeObjectURL(url);
      });
    }
  })();
</script>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  (function () {
    const canvas = document.getElementById('three-fin-canvas');
    if (!canvas) return;

    const container = canvas.parentElement;

    // SCENE, CAMERA, RENDERER
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(9.5, 1.0, 9.5);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight, false);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.target.set(0, -1.6, 0);

    // LIGHTING
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 1.2);
    dirLight1.position.set(8, 12, 10);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x06b6d4, 0.6);
    dirLight2.position.set(-8, -4, -8);
    scene.add(dirLight2);

    const rimLight = new THREE.DirectionalLight(0xf97316, 0.5);
    rimLight.position.set(0, 8, -10);
    scene.add(rimLight);

    // ROCKET ROOT GROUP
    const rocketGroup = new THREE.Group();
    scene.add(rocketGroup);

    // 1. FUSELAGE TUBE (Cylinder along Y)
    const bodyRadius = 1.35;
    const bodyHeight = 9.5;
    const bodyGeom = new THREE.CylinderGeometry(bodyRadius, bodyRadius, bodyHeight, 36);
    const bodyMat = new THREE.MeshStandardMaterial({
      color: 0x1e293b,
      metalness: 0.75,
      roughness: 0.35
    });
    const bodyMesh = new THREE.Mesh(bodyGeom, bodyMat);
    bodyMesh.position.y = 1.2;
    rocketGroup.add(bodyMesh);

    // Accent Rings & Decals
    const ringMat = new THREE.MeshStandardMaterial({ color: 0xf97316, metalness: 0.8, roughness: 0.3 });
    const ring1 = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius + 0.02, bodyRadius + 0.02, 0.12, 36), ringMat);
    ring1.position.y = 4.8;
    rocketGroup.add(ring1);

    const ring2 = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius + 0.02, bodyRadius + 0.02, 0.08, 36), new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.9, roughness: 0.2 }));
    ring2.position.y = -2.0;
    rocketGroup.add(ring2);

    // NOSE CONE
    const noseGeom = new THREE.ConeGeometry(bodyRadius, 3.4, 36);
    const noseMesh = new THREE.Mesh(noseGeom, ringMat);
    noseMesh.position.y = 1.2 + bodyHeight / 2 + 1.7;
    rocketGroup.add(noseMesh);

    // MOTOR NOZZLE
    const nozzleGeom = new THREE.CylinderGeometry(bodyRadius * 0.85, bodyRadius * 0.65, 1.2, 32);
    const nozzleMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.95, roughness: 0.5 });
    const nozzleMesh = new THREE.Mesh(nozzleGeom, nozzleMat);
    nozzleMesh.position.y = 1.2 - bodyHeight / 2 - 0.6;
    rocketGroup.add(nozzleMesh);

    // CENTER OF MASS MARKER RING
    const cmRing = new THREE.Mesh(
      new THREE.TorusGeometry(bodyRadius + 0.03, 0.03, 16, 36),
      new THREE.MeshBasicMaterial({ color: 0xeab308 })
    );
    cmRing.rotation.x = Math.PI / 2;
    cmRing.position.y = 1.6;
    rocketGroup.add(cmRing);

    // 2. 4 ACTIVE CONTROL FINS
    const finColors = [0xf97316, 0x06b6d4, 0x10b981, 0xf59e0b];
    const finAssemblies = [];

    // Fin blade shape (tapered trapezoidal aerofoil in local XY plane)
    const finShape = new THREE.Shape();
    finShape.moveTo(0, -1.4);         // root trailing edge
    finShape.lineTo(2.35, -1.15);     // tip trailing edge (span = 2.35)
    finShape.lineTo(2.35, 0.35);      // tip leading edge
    finShape.lineTo(0, 1.45);         // root leading edge
    finShape.closePath();

    const finExtrudeGeom = new THREE.ExtrudeGeometry(finShape, {
      depth: 0.12,
      bevelEnabled: true,
      bevelThickness: 0.03,
      bevelSize: 0.03,
      bevelSegments: 2
    });
    finExtrudeGeom.translate(0, 0, -0.06); // center thickness along Z

    // Reusable Arrow geometries
    const arrowShaftGeom = new THREE.CylinderGeometry(0.04, 0.04, 1.0, 10);
    arrowShaftGeom.translate(0, 0.5, 0); // origin at base
    const arrowHeadGeom = new THREE.ConeGeometry(0.12, 0.35, 14);
    arrowHeadGeom.translate(0, 1.15, 0);

    for (let i = 0; i < 4; i++) {
      const azimuthPivot = new THREE.Group();
      azimuthPivot.position.set(0, -2.6, 0); // Fin can station along rocket
      rocketGroup.add(azimuthPivot);

      // Radial servo hinge pin (silver cylinder along local X axis)
      const pinGeom = new THREE.CylinderGeometry(0.08, 0.08, 0.5, 16);
      const pinMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.95, roughness: 0.15 });
      const pinMesh = new THREE.Mesh(pinGeom, pinMat);
      pinMesh.rotation.z = Math.PI / 2;
      pinMesh.position.x = bodyRadius + 0.1;
      azimuthPivot.add(pinMesh);

      // FIN HINGE GROUP: Rotates about local X (RADIAL SPANWISE AXIS)!
      const finHinge = new THREE.Group();
      finHinge.position.set(bodyRadius, 0, 0);
      azimuthPivot.add(finHinge);

      // Fin blade mesh
      const finMat = new THREE.MeshStandardMaterial({
        color: finColors[i],
        metalness: 0.35,
        roughness: 0.4
      });
      const finMesh = new THREE.Mesh(finExtrudeGeom, finMat);
      finHinge.add(finMesh);

      // 3D Aerodynamic Lift Force Arrow
      const arrowGroup = new THREE.Group();
      arrowGroup.position.set(1.15, -0.1, 0);
      arrowGroup.visible = false;
      finHinge.add(arrowGroup);

      const arrowMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b,
        emissive: 0xd97706,
        emissiveIntensity: 0.6,
        metalness: 0.8,
        roughness: 0.2
      });
      const shaft = new THREE.Mesh(arrowShaftGeom, arrowMat);
      const head = new THREE.Mesh(arrowHeadGeom, arrowMat);
      arrowGroup.add(shaft);
      arrowGroup.add(head);

      finAssemblies.push({
        azimuthPivot,
        finHinge,
        arrowGroup,
        color: finColors[i]
      });
    }

    // 3. AIRFLOW STREAMLINES (DOWNWARD V_INF)
    const streamlineCount = 42;
    const streamGroup = new THREE.Group();
    scene.add(streamGroup);

    const streamPositions = new Float32Array(streamlineCount * 6);
    const streamSpeeds = new Float32Array(streamlineCount);
    const streamRadii = new Float32Array(streamlineCount);
    const streamThetas = new Float32Array(streamlineCount);
    const streamYs = new Float32Array(streamlineCount);

    for (let i = 0; i < streamlineCount; i++) {
      streamThetas[i] = (i / streamlineCount) * Math.PI * 2 + (Math.random() - 0.5) * 0.2;
      streamRadii[i] = bodyRadius + 0.4 + Math.random() * 2.2;
      streamYs[i] = (Math.random() - 0.5) * 14;
      streamSpeeds[i] = 0.16 + Math.random() * 0.12;
    }

    const streamGeom = new THREE.BufferGeometry();
    streamGeom.setAttribute('position', new THREE.BufferAttribute(streamPositions, 3));
    const streamMat = new THREE.LineBasicMaterial({
      color: 0x06b6d4,
      transparent: true,
      opacity: 0.6
    });
    const streamLines = new THREE.LineSegments(streamGeom, streamMat);
    streamGroup.add(streamLines);

    // SIMULATION STATE
    let mode = 'x'; // 'x' or 'plus'
    let armed = true;
    let showAirflow = true;
    let gustAnim = null;

    // AZIMUTH ANGLES BY MODE
    function updateAzimuths() {
      const angles = mode === 'x'
        ? [Math.PI * 0.25, Math.PI * 0.75, Math.PI * 1.25, Math.PI * 1.75]
        : [0, Math.PI * 0.5, Math.PI, Math.PI * 1.5];

      finAssemblies.forEach((asmb, i) => {
        asmb.azimuthPivot.rotation.y = angles[i];
      });

      const titles = mode === 'x'
        ? [
            'FIN 1: QUADRANT I (45° • PA0/TIM2_CH1)',
            'FIN 2: QUADRANT II (135° • PA1/TIM2_CH2)',
            'FIN 3: QUADRANT III (225° • PA2/TIM2_CH3)',
            'FIN 4: QUADRANT IV (315° • PA3/TIM2_CH4)'
          ]
        : [
            'FIN 1: STARBOARD (0° • PA0/TIM2_CH1)',
            'FIN 2: DORSAL (90° • PA1/TIM2_CH2)',
            'FIN 3: PORT (180° • PA2/TIM2_CH3)',
            'FIN 4: VENTRAL (270° • PA3/TIM2_CH4)'
          ];

      const formulas = mode === 'x'
        ? [
            '-0.71·P - 0.71·Y + R',
            '+0.71·P - 0.71·Y + R',
            '+0.71·P + 0.71·Y + R',
            '-0.71·P + 0.71·Y + R'
          ]
        : [
            '-Pitch + Roll',
            '-Yaw + Roll',
            '+Pitch + Roll',
            '+Yaw + Roll'
          ];

      for (let i = 1; i <= 4; i++) {
        const tEl = document.getElementById(`fin${i}-title`);
        const fEl = document.getElementById(`fin${i}-mix-formula`);
        if (tEl) tEl.textContent = titles[i - 1];
        if (fEl) fEl.textContent = formulas[i - 1];
      }
    }

    updateAzimuths();

    // DOM CONTROLS
    const sPitch = document.getElementById('slider-pitch');
    const sRoll = document.getElementById('slider-roll');
    const sYaw = document.getElementById('slider-yaw');
    const armBtn = document.getElementById('sim-arm-btn');
    const resetBtn = document.getElementById('sim-reset-btn');
    const gustBtn = document.getElementById('sim-gust-btn');

    function clamp(v, lo, hi) {
      return Math.max(lo, Math.min(hi, v));
    }

    function updateSimulation() {
      const pitch = parseFloat(sPitch ? sPitch.value : '0');
      const roll = parseFloat(sRoll ? sRoll.value : '0');
      const yaw = parseFloat(sYaw ? sYaw.value : '0');

      const vP = document.getElementById('val-pitch');
      const vR = document.getElementById('val-roll');
      const vY = document.getElementById('val-yaw');
      if (vP) vP.textContent = (pitch >= 0 ? '+' : '') + pitch.toFixed(1) + '°';
      if (vR) vR.textContent = (roll >= 0 ? '+' : '') + roll.toFixed(1) + '°';
      if (vY) vY.textContent = (yaw >= 0 ? '+' : '') + yaw.toFixed(1) + ' °/s';

      const KP = 1.2;
      const pitchCmd = armed ? clamp(KP * (0 - pitch), -100, 100) : 0;
      const rollCmd = armed ? clamp(KP * (0 - roll), -100, 100) : 0;
      const yawCmd = armed ? clamp((KP * 0.5) * (0 - yaw), -100, 100) : 0;

      const oP = document.getElementById('out-pitch-cmd');
      const oR = document.getElementById('out-roll-cmd');
      const oY = document.getElementById('out-yaw-cmd');
      if (oP) oP.textContent = (pitchCmd >= 0 ? '+' : '') + pitchCmd.toFixed(2);
      if (oR) oR.textContent = (rollCmd >= 0 ? '+' : '') + rollCmd.toFixed(2);
      if (oY) oY.textContent = (yawCmd >= 0 ? '+' : '') + yawCmd.toFixed(2);

      let f1_def, f2_def, f3_def, f4_def;

      if (mode === 'x') {
        const pDef = pitchCmd * 0.7071 * 0.9;
        const yDef = yawCmd * 0.7071 * 0.9;
        const rDef = rollCmd * 0.9;

        f1_def = -pDef - yDef + rDef;
        f2_def = +pDef - yDef + rDef;
        f3_def = +pDef + yDef + rDef;
        f4_def = -pDef + yDef + rDef;
      } else {
        const pDef = pitchCmd * 0.9;
        const yDef = yawCmd * 0.9;
        const rDef = rollCmd * 0.9;

        f1_def = -pDef + rDef;
        f2_def = -yDef + rDef;
        f3_def = +pDef + rDef;
        f4_def = +yDef + rDef;
      }

      const defs = [f1_def, f2_def, f3_def, f4_def];
      const angles = defs.map((d) => clamp(Math.round(90 + d), 0, 180));

      // 1. UPDATE 3D THREE.JS FIN HINGES ON THEIR RADIAL SPANWISE AXIS!
      finAssemblies.forEach((asmb, i) => {
        const defDeg = clamp(angles[i] - 90, -35, 35);
        const defRad = (defDeg * Math.PI) / 180;

        // PIVOT ON RADIAL AXIS (Local X)
        asmb.finHinge.rotation.x = defRad;

        // 2. 3D AERODYNAMIC LIFT FORCE ARROW
        if (Math.abs(defDeg) < 0.6) {
          asmb.arrowGroup.visible = false;
        } else {
          asmb.arrowGroup.visible = true;
          const mag = clamp(Math.abs(defDeg) / 25, 0.3, 1.8);
          asmb.arrowGroup.scale.set(mag, mag, mag);

          if (defDeg > 0) {
            asmb.arrowGroup.rotation.x = Math.PI / 2;
          } else {
            asmb.arrowGroup.rotation.x = -Math.PI / 2;
          }
        }
      });

      // 3. VEHICLE ATTITUDE VISUAL REACTION
      rocketGroup.rotation.z = -(pitch * Math.PI) / 180 * 0.25;
      rocketGroup.rotation.x = (roll * Math.PI) / 180 * 0.25;
      rocketGroup.rotation.y = (yaw * Math.PI) / 180 * 0.25;

      // 4. UPDATE UI CARDS & BARS
      for (let i = 1; i <= 4; i++) {
        const ang = angles[i - 1];
        const defVal = ang - 90;
        const us = Math.round(1000 + (ang * 1000) / 180);

        const bdg = document.getElementById(`fin${i}-angle-badge`);
        const bar = document.getElementById(`fin${i}-bar`);
        const dt = document.getElementById(`fin${i}-deflect-deg`);

        if (bdg) bdg.textContent = `${ang}° (${us} µs)`;
        if (bar) bar.style.width = `${(ang / 180) * 100}%`;
        if (dt) dt.textContent = (defVal >= 0 ? '+' : '') + defVal.toFixed(1) + '°';
      }

      // 5. UPDATE CSV LINE
      const csvEl = document.getElementById('sim-csv-line');
      if (csvEl) {
        csvEl.textContent = `${pitch.toFixed(2)},${roll.toFixed(2)},${yaw.toFixed(2)},${pitchCmd.toFixed(2)},${rollCmd.toFixed(2)},${yawCmd.toFixed(2)},${angles[0]},${angles[1]},${angles[2]},${angles[3]},${armed ? 1 : 0}`;
      }
    }

    if (sPitch) sPitch.addEventListener('input', updateSimulation);
    if (sRoll) sRoll.addEventListener('input', updateSimulation);
    if (sYaw) sYaw.addEventListener('input', updateSimulation);

    // AUTOPILOT ARM BUTTON
    if (armBtn) {
      armBtn.addEventListener('click', () => {
        armed = !armed;
        const dot = document.getElementById('sim-led-dot');
        const ledTitle = document.getElementById('sim-led-title');
        if (armed) {
          armBtn.textContent = 'STATE: ARMED (ACTIVE PID CONTROL)';
          armBtn.classList.add('btn-primary');
          if (dot) { dot.style.background = '#ef4444'; dot.style.boxShadow = '0 0 12px #ef4444'; }
          if (ledTitle) ledTitle.textContent = 'PB9 WS2812B: SOLID RED (255, 0, 0) — ARMED';
        } else {
          armBtn.textContent = 'STATE: DISARMED (FINS LOCKED AT 90°)';
          armBtn.classList.remove('btn-primary');
          if (dot) { dot.style.background = '#22c55e'; dot.style.boxShadow = '0 0 12px #22c55e'; }
          if (ledTitle) ledTitle.textContent = 'PB9 WS2812B: SOLID GREEN (0, 255, 0) — DISARMED';
        }
        updateSimulation();
      });
    }

    // RESET BUTTON
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (gustAnim) clearInterval(gustAnim);
        if (sPitch) sPitch.value = '0';
        if (sRoll) sRoll.value = '0';
        if (sYaw) sYaw.value = '0';
        updateSimulation();
      });
    }

    // WIND GUST BUTTON
    if (gustBtn) {
      gustBtn.addEventListener('click', () => {
        if (gustAnim) clearInterval(gustAnim);
        let step = 0;
        const totalSteps = 60;
        gustAnim = setInterval(() => {
          step++;
          const t = step / totalSteps;
          const decay = Math.exp(-3 * t);
          const gustAngle = 24 * Math.sin(t * 12) * decay;
          const gustRoll = -16 * Math.cos(t * 10) * decay;
          if (sPitch) sPitch.value = gustAngle.toFixed(1);
          if (sRoll) sRoll.value = gustRoll.toFixed(1);
          updateSimulation();
          if (step >= totalSteps) {
            clearInterval(gustAnim);
            gustAnim = null;
            if (sPitch) sPitch.value = '0';
            if (sRoll) sRoll.value = '0';
            updateSimulation();
          }
        }, 30);
      });
    }

    // CONFIG BUTTONS
    const btnCfgX = document.getElementById('btn-cfg-x');
    const btnCfgPlus = document.getElementById('btn-cfg-plus');

    if (btnCfgX && btnCfgPlus) {
      btnCfgX.addEventListener('click', () => {
        mode = 'x';
        btnCfgX.classList.add('active');
        btnCfgPlus.classList.remove('active');
        updateAzimuths();
        updateSimulation();
      });

      btnCfgPlus.addEventListener('click', () => {
        mode = 'plus';
        btnCfgPlus.classList.add('active');
        btnCfgX.classList.remove('active');
        updateAzimuths();
        updateSimulation();
      });
    }

    // CAMERA PRESETS
    const btnCamOrbit = document.getElementById('btn-cam-orbit');
    const btnCamSide = document.getElementById('btn-cam-side');
    const btnCamAft = document.getElementById('btn-cam-aft');
    const btnToggleFlow = document.getElementById('btn-toggle-flow');

    function setActiveCamBtn(btn) {
      [btnCamOrbit, btnCamSide, btnCamAft].forEach((b) => b && b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    if (btnCamOrbit) {
      btnCamOrbit.addEventListener('click', () => {
        setActiveCamBtn(btnCamOrbit);
        camera.position.set(9.5, 1.0, 9.5);
        camera.up.set(0, 1, 0);
        controls.target.set(0, -1.6, 0);
      });
    }

    if (btnCamSide) {
      btnCamSide.addEventListener('click', () => {
        setActiveCamBtn(btnCamSide);
        camera.position.set(0, -1.8, 10.5);
        camera.up.set(0, 1, 0);
        controls.target.set(0, -1.8, 0);
      });
    }

    if (btnCamAft) {
      btnCamAft.addEventListener('click', () => {
        setActiveCamBtn(btnCamAft);
        camera.position.set(0, -10.5, 0.01);
        camera.up.set(0, 0, 1);
        controls.target.set(0, -2.6, 0);
      });
    }

    if (btnToggleFlow) {
      btnToggleFlow.addEventListener('click', () => {
        showAirflow = !showAirflow;
        streamGroup.visible = showAirflow;
        btnToggleFlow.textContent = showAirflow ? 'AIRFLOW: ON' : 'AIRFLOW: OFF';
      });
    }

    // ANIMATION & RENDER LOOP
    function animate() {
      requestAnimationFrame(animate);

      if (showAirflow) {
        const pos = streamPositions;
        for (let i = 0; i < streamlineCount; i++) {
          streamYs[i] -= streamSpeeds[i];
          if (streamYs[i] < -7) streamYs[i] = 7;

          const th = streamThetas[i];
          const r = streamRadii[i];
          const y = streamYs[i];

          const idx = i * 6;
          pos[idx] = Math.cos(th) * r;
          pos[idx + 1] = y + 0.6;
          pos[idx + 2] = Math.sin(th) * r;

          pos[idx + 3] = Math.cos(th) * r;
          pos[idx + 4] = y - 0.6;
          pos[idx + 5] = Math.sin(th) * r;
        }
        streamGeom.attributes.position.needsUpdate = true;
      }

      controls.update();
      renderer.render(scene, camera);
    }

    animate();
    updateSimulation();

    // CONTAINER RESIZE OBSERVER (handles layout changes, not just window resize)
    function resizeRenderer() {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w && h) {
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      }
    }
    resizeRenderer();
    if ('ResizeObserver' in window) {
      new ResizeObserver(resizeRenderer).observe(container);
    } else {
      window.addEventListener('resize', resizeRenderer);
    }
  })();
</script>

