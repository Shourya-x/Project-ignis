<script is:inline define:vars={{ SAMPLE_FLIGHT_DATA }}>
  // ==========================================
  // 1. 3D STUDIO MODEL SWITCHER & CONTROLS
  // ==========================================
  (function () {
    const viewer = document.getElementById('ignis-3d-viewer');
    const titleEl = document.getElementById('viewer-model-title');
    const metaEl = document.getElementById('viewer-model-meta');
    const tabs = document.querySelectorAll('.model-tab');

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabs.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const src = btn.getAttribute('data-src');
        const t = btn.getAttribute('data-title');
        const m = btn.getAttribute('data-meta');
        if (viewer && src) viewer.setAttribute('src', src);
        if (titleEl && t) titleEl.textContent = t;
        if (metaEl && m) metaEl.textContent = m;
      });
    });

    const isoBtn = document.getElementById('cam-iso');
    const topBtn = document.getElementById('cam-top');
    const sideBtn = document.getElementById('cam-side');
    const rotBtn = document.getElementById('toggle-rot');

    if (isoBtn && viewer) isoBtn.addEventListener('click', () => { viewer.cameraOrbit = '35deg 60deg auto'; });
    if (topBtn && viewer) topBtn.addEventListener('click', () => { viewer.cameraOrbit = '0deg 5deg auto'; });
    if (sideBtn && viewer) sideBtn.addEventListener('click', () => { viewer.cameraOrbit = '90deg 85deg auto'; });
    if (rotBtn && viewer) {
      rotBtn.addEventListener('click', () => {
        if (viewer.hasAttribute('auto-rotate')) {
          viewer.removeAttribute('auto-rotate');
          rotBtn.textContent = 'AUTO-ROTATE: OFF';
        } else {
          viewer.setAttribute('auto-rotate', '');
          rotBtn.textContent = 'AUTO-ROTATE: ON';
        }
      });
    }
  })();

  // (Section 02 3D Fin Kinematics handled in modular Three.js script below)

