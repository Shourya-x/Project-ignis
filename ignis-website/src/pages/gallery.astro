---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Hardware Gallery & Renders | Project IGNIS">
  <Header />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-index">GALLERY // 3D MODELS, RENDERS &amp; VECTOR PLOTS</span>
          <h1 class="section-title">Hardware Gallery &amp; ECAD Plots</h1>
        </div>
        <p class="section-desc">
          Interactive 3D WebGL viewers and high-resolution KiCad vector plots of the IGNIS avionics systems and rocket airframe.
        </p>
      </div>

      <!-- 3D Interactive Viewers -->
      <h2 class="sub-title mono">1. Interactive 3D WebGL Hardware &amp; Airframe Assemblies</h2>
      <div class="gallery-3d-grid">
        <div class="panel viewer-card">
          <div class="viewer-head mono">
            <span>IGNIS-CORE Populated PCBA</span>
            <span class="badge badge-accent">.GLB</span>
          </div>
          <model-viewer
            src="/models/ignis-core-pcb.glb"
            alt="IGNIS-CORE 3D PCB"
            auto-rotate
            camera-controls
            shadow-intensity="1"
            exposure="1.1"
            class="gallery-viewer"
          ></model-viewer>
          <p class="viewer-desc mono">Populated STM32G473VET6 board with Ra-02 LoRa, MPU-6500, MS5611, and TO-220 MOSFETs.</p>
        </div>

        <div class="panel viewer-card">
          <div class="viewer-head mono">
            <span>Auxiliary Blackbox Data Logger</span>
            <span class="badge badge-blue">.GLB</span>
          </div>
          <model-viewer
            src="/models/datalogger-pcb.glb"
            alt="Data Logger 3D PCB"
            auto-rotate
            camera-controls
            shadow-intensity="1"
            exposure="1.1"
            class="gallery-viewer"
          ></model-viewer>
          <p class="viewer-desc mono">Independent ATmega328P-AU recorder with dual 24LC1025 EEPROMs and DS1337S+ RTC.</p>
        </div>

        <div class="panel viewer-card">
          <div class="viewer-head mono">
            <span>Modular Avionics Bay Assembly</span>
            <span class="badge badge-green">.GLTF</span>
          </div>
          <model-viewer
            src="/models/AvionicsBay.gltf"
            alt="Avionics Bay"
            auto-rotate
            camera-controls
            shadow-intensity="1"
            exposure="1.1"
            class="gallery-viewer"
          ></model-viewer>
          <p class="viewer-desc mono">Internal shock-damped electronics sled and structural airframe bulkheads.</p>
        </div>

        <div class="panel viewer-card">
          <div class="viewer-head mono">
            <span>Complete Rocket Assembly</span>
            <span class="badge badge-amber">.GLTF</span>
          </div>
          <model-viewer
            src="/models/Rocket.gltf"
            alt="Rocket Assembly"
            auto-rotate
            camera-controls
            shadow-intensity="1"
            exposure="1.1"
            class="gallery-viewer"
          ></model-viewer>
          <p class="viewer-desc mono">Full parametric airframe with nose cone, payload section, and 4-fin control can.</p>
        </div>
      </div>

      <!-- Raytraced Renders & Vector Plots -->
      <h2 class="sub-title mono" style="margin-top:3rem;">2. Raytraced 3D Renders &amp; Copper Plots</h2>
      <div class="gallery-img-grid">
        <div class="panel img-card">
          <img src="/renders/ignis-core-3d-iso.png" alt="IGNIS-CORE 3D ISO" />
          <div class="img-meta mono">
            <strong>IGNIS-CORE 3D Isometric View</strong>
            <span>Raytraced via KiCad 3D Engine</span>
          </div>
        </div>

        <div class="panel img-card">
          <img src="/renders/ignis-core-3d-top.png" alt="IGNIS-CORE 3D Top" />
          <div class="img-meta mono">
            <strong>IGNIS-CORE Top Placement</strong>
            <span>LQFP-100 &amp; Peripheral Component Map</span>
          </div>
        </div>

        <div class="panel img-card">
          <img src="/renders/datalogger-3d-iso.png" alt="Data Logger 3D ISO" />
          <div class="img-meta mono">
            <strong>Aux Data Logger 3D View</strong>
            <span>Dual EEPROM Array &amp; RTC Stacking</span>
          </div>
        </div>

        <div class="panel img-card">
          <div class="svg-container">
            <img src="/renders/ignis-core-pcb-top.svg" alt="IGNIS-CORE Top Copper" />
          </div>
          <div class="img-meta mono">
            <strong>IGNIS-CORE Top Copper (F.Cu)</strong>
            <span>Vector SVG Layer Plot</span>
          </div>
        </div>

        <div class="panel img-card">
          <div class="svg-container">
            <img src="/renders/ignis-core-pcb-bottom.svg" alt="IGNIS-CORE Bottom Copper" />
          </div>
          <div class="img-meta mono">
            <strong>IGNIS-CORE Bottom Copper (B.Cu)</strong>
            <span>Vector SVG Layer Plot</span>
          </div>
        </div>

        <div class="panel img-card">
          <div class="svg-container">
            <img src="/renders/datalogger-pcb-top.svg" alt="Data Logger Top Copper" />
          </div>
          <div class="img-meta mono">
            <strong>Data Logger Top Copper (F.Cu)</strong>
            <span>Vector SVG Layer Plot</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .sub-title {
    font-size: 1.15rem;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .gallery-3d-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .viewer-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .viewer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
  }
  .gallery-viewer {
    width: 100%;
    height: 320px;
    background: radial-gradient(circle at center, var(--bg-subtle), var(--bg));
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .viewer-desc {
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .gallery-img-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .img-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .img-card img {
    max-width: 100%;
    max-height: 240px;
    object-fit: contain;
  }
  .svg-container {
    background: #ffffff;
    padding: 1rem;
    border-radius: 6px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 220px;
  }
  .img-meta {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.76rem;
  }
  .img-meta span {
    color: var(--text-muted);
    font-size: 0.72rem;
  }
</style>
